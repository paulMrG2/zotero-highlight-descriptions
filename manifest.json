{
  "manifest_version": 2,
  "name": "Highlight color descriptions",
  "version": "1.3.2",
  "description": "Adds custom description labels to highlight colors in Zotero context menus.",
  "author": "Paul Groth",
  "icons": {
    "48": "chrome/content/icons/icon48.png"
  },
  "applications": {
    "zotero": {
      "id": "highlightdescriptions@paulmrg2",
      "update_url": "https://raw.githubusercontent.com/paulmrg2/zotero-highlight-descriptions/main/update.json",
      "strict_min_version": "8.0",
      "strict_max_version": "10.*"
    }
  }
}
